{
  "name": "@personal-hub/backend",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm test && npm run test:integration",
    "clean": "rm -rf dist .wrangler node_modules"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@personal-hub/shared": "workspace:*",
    "@tsndr/cloudflare-worker-jwt": "^3.2.0",
    "drizzle-orm": "^0.36.1",
    "hono": "^4.7.6",
    "jose": "^6.0.12",
    "lucia": "^3.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250104.2",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.30.6",
    "miniflare": "^3.20250408.2",
    "nanoid": "^5.1.5",
    "wrangler": "^3.102.3"
  }
}