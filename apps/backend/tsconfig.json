{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "ES2024.String"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "types": ["@cloudflare/workers-types", "node"],
    "outDir": "./dist",
    "noEmit": false,
    "isolatedModules": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}